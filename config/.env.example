# Optional: enables model-backed summaries and answer evaluation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1/responses
# Optional: comma-separated RSS/Atom feeds to add to the general lane.
GENERAL_FEEDS=https://openai.com/news/rss.xml,https://blog.google/technology/ai/rss/
# Optional: comma-separated RSS/Atom feeds to add to the SRE/DevOps lane.
DOMAIN_FEEDS=https://aws.amazon.com/blogs/devops/feed/,https://cloud.google.com/blog/products/management-tools/rss
# Automatic refresh interval. The server checks hourly and scans when this age is reached.
SCAN_INTERVAL_HOURS=24
