# Optional: enables model-backed summaries and answer evaluation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1/responses
# Optional: comma-separated RSS/Atom feeds to replace the general lane defaults.
# Defaults also include Google Research, Apple ML, AWS ML, and Netflix TechBlog.
GENERAL_FEEDS=https://openai.com/news/rss.xml,https://blog.google/technology/ai/rss/,https://research.google/blog/rss/,https://machinelearning.apple.com/rss.xml,https://aws.amazon.com/blogs/machine-learning/feed/,https://netflixtechblog.com/feed
# Optional: comma-separated RSS/Atom feeds to replace the domain lane defaults.
DOMAIN_FEEDS=https://aws.amazon.com/blogs/devops/feed/
# Optional: comma-separated public RSS/Atom job feeds or employer ATS sources.
# Public ATS sources use greenhouse://<board-slug>, lever://<company-slug>, or
# ashby://<job-board-name>. If left blank, the app uses a curated Bay Area set
# covering OpenAI, infrastructure/AI startups, Gallup, and Palantir. Do not put
# LinkedIn, Indeed, or Glassdoor login URLs here; use their
# official API, export, or alert feed only where your account and the provider
# permit it.
# Example:
# JOB_FEEDS=ashby://openai,greenhouse://example-company,https://example.org/jobs.xml
JOB_FEEDS=
# Opportunity scan cadence follows the daily source interval unless overridden.
OPPORTUNITY_STATE_PATH=backend/data/opportunities.json
# Automatic refresh interval. The server checks hourly and scans when this age is reached.
SCAN_INTERVAL_HOURS=24
